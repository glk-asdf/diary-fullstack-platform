# ============================================================
# 环境变量模板：复制为 .env 后填写真实值，.env 不要提交到 Git
# ============================================================

# ---------- MySQL ----------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=diary
DB_USER=root
# 本机免安装版 MySQL 的 root 密码（启动方式见 D:\business\tools\mysql-start.ps1）
DB_PASSWORD=123456

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- JWT ----------
# 至少 256 位随机字符串，泄露等于所有账号沦陷
JWT_SECRET=replace-with-a-random-string-of-at-least-32-bytes
# Access Token 有效期（秒），默认 30 分钟
JWT_ACCESS_EXPIRE=1800
# Refresh Token 有效期（秒），默认 7 天
JWT_REFRESH_EXPIRE=604800

# ---------- MinIO ----------
# 后端访问地址；容器部署时应为内网地址（如 http://minio:9000）
MINIO_ENDPOINT=http://127.0.0.1:9000
# 浏览器访问地址，与上面的 endpoint 分开配置以适配容器部署
MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=diary
# 单文件大小上限（字节），默认 5MB
MINIO_MAX_FILE_SIZE=5242880
