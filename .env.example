# ============================================================
# Docker Compose 部署环境变量
#
# 用法：复制本文件为 .env 后修改真实值。.env 已被 .gitignore 忽略，绝不提交。
#
# 注意：本文件只被 docker compose 读取。
# 本地开发（.\mvnw.cmd spring-boot:run）不需要 .env ——
# 相关默认值都在 backend/src/main/resources/application-dev.yml 里。
#
# 标有「必填」的项若未设置，docker compose 会直接报错退出，
# 这是刻意设计：宁可起不来，也不要带着默认弱密码上线。
# ============================================================

# ---------- 对外端口 ----------
# Nginx 监听端口；非 root 或 80 被占用时改成 8080 等
APP_PORT=80

# ---------- MySQL ----------
DB_NAME=diary
# 必填。容器内 root 密码，也是本应用连接数据库使用的密码
DB_PASSWORD=change-me-strong-password
# 容器 MySQL 映射到宿主机的端口，仅供本地数据库客户端连接（仅监听 127.0.0.1）。
# 用 3307 是为了避开本地开发库占用的 3306。
DB_HOST_PORT=3307

# ---------- Redis ----------
# 仅容器内网访问，默认无密码；如需对外暴露请自行加 requirepass 并同步此值
REDIS_PASSWORD=

# ---------- JWT ----------
# 必填。HS256 要求至少 256 位（32 字节）。生成方式任选其一：
#   powershell: [Convert]::ToBase64String([byte[]](1..48 | ForEach-Object { Get-Random -Maximum 256 }))
#   openssl:    openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
# Access Token 有效期（秒），默认 30 分钟
JWT_ACCESS_EXPIRE=1800
# Refresh Token 有效期（秒），默认 7 天
JWT_REFRESH_EXPIRE=604800

# ---------- MinIO ----------
# 必填。两者都改掉，不要沿用 minioadmin
MINIO_ACCESS_KEY=diary-minio-admin
MINIO_SECRET_KEY=change-me-strong-password
MINIO_BUCKET=diary
# 单文件大小上限（字节），默认 5MB
MINIO_MAX_FILE_SIZE=5242880
